000000r 2               ; last known timestamp with date set to 1970-01-01
000000r 2               rtc_systime_t = $0300
000000r 2               
000000r 2               
000000r 2               ;----------------------------------------------------------------------------
000000r 2               ; time struct with date set to 1970-01-01
000000r 2               .struct time_t
000000r 2               		  tm_sec	.byte		;0-59
000000r 2               		  tm_min	.byte		;0-59
000000r 2               		  tm_hour	.byte		;0-23
000000r 2               		  tm_wday	.byte		;
000000r 2               		  tm_mday	.byte		;1-31
000000r 2               		  tm_mon	.byte	;1	;0-11 0-jan, 11-dec
000000r 2               		  tm_year	.byte  ;70	;years since 1900
000000r 2               .endstruct
