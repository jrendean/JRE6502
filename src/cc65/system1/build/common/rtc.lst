000000r 1               
000000r 1               ;
000000r 1               ; https://bitbucket.org/steckschwein/steckschwein-code/src/master/steckos/libsrc/ds1306/rtc.s
000000r 1               ;
000000r 1               
000000r 1               .import spi_select_device, spi_deselect, spi_r_byte, spi_rw_byte
000000r 1               
000000r 1               .export rtc_init, rtc_systime_update
000000r 1               .export rtc_settime
000000r 1               
000000r 1               ;----------------------------------------------------------------------------
000000r 1               ; last known timestamp with date set to 1970-01-01
000000r 1               ;rtc_systime_t = $0300
000000r 1               
000000r 1               ; read rtc
000000r 1               rtc_read = $00
000000r 1               rtc_write = $80
000000r 1               
000000r 1               rtc_ctrlreg = $0F
000000r 1               
000000r 1               .code
000000r 1               
000000r 1                 ; out:
000000r 1                 ;    Z=1 spi for rtc could be selected (not busy), Z=0 otherwise
000000r 1                 rtc_init:
000000r 1                   ; Select SPI SS for RTC
000000r 1  A9 16            lda #spi_device_rtc
000002r 1  20 rr rr         jsr spi_select_device
000005r 1               
000005r 1                   ; disable RTC interrupts
000005r 1  A9 8F            lda #rtc_write | rtc_ctrlreg
000007r 1  20 rr rr         jsr spi_rw_byte
00000Ar 1  A9 00            lda #$00 ; disable INT0, INT1, WP (Write Protect)
00000Cr 1                   ; this is super noisy
00000Cr 1                   ;lda #4 ; output 1hz signal
00000Cr 1               
00000Cr 1  20 rr rr         jsr spi_rw_byte
00000Fr 1               
00000Fr 1  20 rr rr         jsr spi_deselect
000012r 1               
000012r 1  4C rr rr         jmp rtc_systime_update
000015r 1               
000015r 1  60               rts
000016r 1               
000016r 1               
000016r 1               
000016r 1               
000016r 1                 rtc_settime:
000016r 1  A9 16            lda #spi_device_rtc
000018r 1  20 rr rr         jsr spi_select_device
00001Br 1               
00001Br 1  A9 80            lda #rtc_write
00001Dr 1  20 rr rr         jsr spi_rw_byte
000020r 1               
000020r 1                   ;; all bcd
000020r 1               
000020r 1                   ; second
000020r 1  A9 00            lda #00
000022r 1  20 rr rr         jsr spi_rw_byte
000025r 1               
000025r 1                   ; minute
000025r 1  A9 0A            lda #%00001010
000027r 1  20 rr rr         jsr spi_rw_byte
00002Ar 1               
00002Ar 1                   ; hour
00002Ar 1  A9 08            lda #%00001000
00002Cr 1  20 rr rr         jsr spi_rw_byte
00002Fr 1               
00002Fr 1                   ; day of the week
00002Fr 1  A9 02            lda #2
000031r 1  20 rr rr         jsr spi_rw_byte
000034r 1               
000034r 1                   ; date
000034r 1  A9 27            lda #%00100111
000036r 1  20 rr rr         jsr spi_rw_byte
000039r 1               
000039r 1                   ; month
000039r 1  A9 04            lda #%00000100
00003Br 1  20 rr rr         jsr spi_rw_byte
00003Er 1               
00003Er 1                   ; year
00003Er 1  A9 21            lda #%00100001
000040r 1  20 rr rr         jsr spi_rw_byte
000043r 1               
000043r 1  20 rr rr         jsr spi_deselect
000046r 1               
000046r 1  60             rts
000047r 1               
000047r 1               
000047r 1               
000047r 1               
000047r 1                 ;in:
000047r 1                 ;  -
000047r 1                 ;out:
000047r 1                 ;  - rtc_systime_t updated
000047r 1                 rtc_systime_update:
000047r 1  A9 16            lda #spi_device_rtc
000049r 1  20 rr rr         jsr spi_select_device
00004Cr 1  F0 01            beq @continue
00004Er 1                   ; cannot select device
00004Er 1  60               rts
00004Fr 1               
00004Fr 1                 @continue:
00004Fr 1  A9 00            lda #0            ;0 means rtc read, start from first address (seconds)
000051r 1  20 rr rr         jsr spi_rw_byte
000054r 1               
000054r 1  20 rr rr         jsr spi_r_byte    ;seconds
000057r 1  20 rr rr         jsr BCD2dec
00005Ar 1  8D 00 03         sta rtc_systime_t+time_t::tm_sec
00005Dr 1               
00005Dr 1  20 rr rr         jsr spi_r_byte    ;minute
000060r 1  20 rr rr         jsr BCD2dec
000063r 1  8D 01 03         sta rtc_systime_t+time_t::tm_min
000066r 1               
000066r 1  20 rr rr         jsr spi_r_byte    ;hour
000069r 1  20 rr rr         jsr BCD2dec
00006Cr 1  8D 02 03         sta rtc_systime_t+time_t::tm_hour
00006Fr 1               
00006Fr 1  20 rr rr         jsr spi_r_byte    ;week day
000072r 1  8D 03 03         sta rtc_systime_t+time_t::tm_wday
000075r 1               
000075r 1  20 rr rr         jsr spi_r_byte    ;day of month
000078r 1  20 rr rr         jsr BCD2dec
00007Br 1  8D 04 03         sta rtc_systime_t+time_t::tm_mday
00007Er 1               
00007Er 1  20 rr rr         jsr spi_r_byte    ;month
000081r 1  20 rr rr         jsr BCD2dec
000084r 1  8D 05 03         sta rtc_systime_t+time_t::tm_mon
000087r 1               
000087r 1  20 rr rr         jsr spi_r_byte    ;year
00008Ar 1  20 rr rr         jsr BCD2dec
00008Dr 1  8D 06 03         sta rtc_systime_t+time_t::tm_year
000090r 1               
000090r 1               
000090r 1  20 rr rr         jsr spi_deselect
000093r 1               
000093r 1  38               sec
000094r 1  60               rts
000095r 1               
000095r 1               
000095r 1                 ; dec = (((BCD>>4)*10) + (BCD&0xf))
000095r 1                 BCD2dec:
000095r 1  AA               tax
000096r 1  29 0F            and #%00001111
000098r 1  85 rr            sta tmp1
00009Ar 1  8A               txa
00009Br 1  29 F0            and #%11110000        ; highbyte => 10a = 8a + 2a
00009Dr 1  4A               lsr                     ; 2a
00009Er 1  85 rr            sta tmp2
0000A0r 1  4A               lsr                      ;
0000A1r 1  4A               lsr                      ; 8a
0000A2r 1  65 rr            adc tmp2      ; = *10
0000A4r 1  65 rr            adc tmp1
0000A6r 1  60               rts
0000A6r 1               
