000000r 1               .import __RAM_START__, __RAM_SIZE__
000000r 1               .export mem_clear
000000r 1               
000000r 1                 mem_clear:
000000r 1  A9 00            lda #$00
000002r 1  85 rr            sta ptr1
000004r 1  A9 rr            lda #>__RAM_START__
000006r 1  85 rr            sta ptr1+1
000008r 1  A2 rr            ldx #>__RAM_SIZE__
00000Ar 1  A9 00            : lda #$00
00000Cr 1  A8               tay
00000Dr 1  91 rr            : sta (ptr1),y
00000Fr 1  88               dey
000010r 1  D0 FB            bne :-
000012r 1  E6 rr            inc ptr1+1
000014r 1  CA               dex
000015r 1  D0 F3            bne :--
000017r 1               
000017r 1  60               rts
