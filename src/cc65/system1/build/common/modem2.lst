000000r 2               ;
000000r 2               .macro loadptr src, dest
000000r 2                 lda #<(src)
000000r 2                 sta dest
000000r 2                 lda #>(src)
000000r 2                 sta dest + 1
000000r 2               .endmacro
000000r 2               
000000r 2               .macro copyptr111 src, dest
000000r 2                 lda src
000000r 2                 sta dest
000000r 2                 lda src + 1
000000r 2                 sta dest + 1
000000r 2               .endmacro
