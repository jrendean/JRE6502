000000r 1               
000000r 1               .import delay_ms
000000r 1               .import console_is_data_available, console_write_byte, console_read_byte, console_write_string
000000r 1               
000000r 1               .export modem_receive
000000r 1               
000000r 1               ;http://6502.org/source/io/xmodem/xmodem-receive.txt
000000r 1               
000000r 1               ; Original implementation by Daryl Rictor
000000r 1               ; Slightly modified for this build (IRQ-based ACIA)
000000r 1               
000000r 1               ; Constants used
000000r 1               NULL    = $00   ; Null char
000000r 1               SOH     = $01   ; Start of Heading
000000r 1               ETX     = $03   ; End of Text
000000r 1               EOT     = $04   ; End of Transmission
000000r 1               ACK     = $06   ; Acknowledgement
000000r 1               LF      = $0a   ; Line Feed
000000r 1               CR      = $0d   ; Carriage Return
000000r 1               NAK     = $15   ; Negative Acknowledgement
000000r 1               CAN     = $18   ; Cancel
000000r 1               ESC     = $1b   ; Escape
000000r 1               SPACE   = $20   ; Space
000000r 1               DEL     = $7f   ; Delete
000000r 1               BS      = $7f   ; Backspace on Mac
000000r 1               
000000r 1               RECEIVE_BUFFER_SIZE = 140
000000r 1               
000000r 1               ; Private modem variables
000000r 1                       .zeropage
000000r 1  xx xx        crc:              .res 2
000002r 1  xx           blkno:     .res 1
000003r 1  xx           bflag: .res 1
000004r 1  xx xx        ptr:   .res 2
000006r 1  xx           delay_counter:    .res 1
000007r 1  xx           retry:    .res 1
000008r 1  xx           retry2:    .res 1
000009r 1               
000009r 1                       .code
000000r 1               modem_receive:
000000r 1               		;jsr	PrintMsg	; send prompt and info
000000r 1  A9 rr 85 rr      loadptr prompt, console_out_ptr
000004r 1  A9 rr 85 rr  
000008r 1  20 rr rr         jsr console_write_string
00000Br 1  A9 01        		lda	#$01
00000Dr 1  85 rr        		sta	blkno		; set block # to 1
00000Fr 1  85 rr        		sta	bflag		; set flag to get address from block 1
000011r 1  A9 43        StartCrc:	lda	#'C'		; "C" start with CRC mode
000013r 1  20 rr rr     		jsr	console_write_byte		; send it
000016r 1  A9 FF        		lda	#$FF
000018r 1  85 rr        		sta	retry2		; set loop counter for ~3 sec delay
00001Ar 1  A9 00        		lda	#$00
00001Cr 1  85 rr                       	sta	crc
00001Er 1  85 rr        		sta	crc+1		; init CRC value
000020r 1  20 rr rr     		jsr	GetByte		; wait for input
000023r 1  B0 11                       	bcs	GotByte		; byte received, process it
000025r 1  90 EA        		bcc	StartCrc	; resend "C"
000027r 1               
000027r 1  A9 FF        StartBlk:	lda	#$FF		;
000029r 1  85 rr        		sta	retry2		; set loop counter for ~3 sec delay
00002Br 1  A9 00        		lda	#$00		;
00002Dr 1  85 rr        		sta	crc		;
00002Fr 1  85 rr        		sta	crc+1		; init CRC value
000031r 1  20 rr rr     		jsr	GetByte		; get first byte of block
000034r 1  90 F1        		bcc	StartBlk	; timed out, keep waiting...
000036r 1  C9 1B        GotByte:		cmp	#ESC		; quitting?
000038r 1  D0 01                        bne	GotByte1	; no
00003Ar 1               ;		lda	#$FE		; Error code in "A" of desired
00003Ar 1  00                           brk			; YES - do BRK or change to RTS if desired
00003Br 1  C9 01        GotByte1:        cmp	#SOH		; start of block?
00003Dr 1  F0 07        		beq	BegBlk		; yes
00003Fr 1  C9 04        		cmp	#EOT		;
000041r 1  D0 61        		bne	BadCrc		; Not SOH or EOT, so flush buffer & send NAK
000043r 1  4C rr rr     		jmp	Done		; EOT - all done!
000046r 1  A2 00        BegBlk:		ldx	#$00
000048r 1  A9 FF        GetBlk:		lda	#$ff		; 3 sec window to receive characters
00004Ar 1  85 rr        		sta 	retry2		;
00004Cr 1  20 rr rr     GetBlk1:		jsr	GetByte		; get next character
00004Fr 1  90 53        		bcc	BadCrc		; chr rcv error, flush and send NAK
000051r 1  9D rr rr     GetBlk2:		sta	Rbuff,x		; good char, save it in the rcv buffer
000054r 1  E8           		inx			; inc buffer pointer
000055r 1  E0 84        		cpx	#$84		; <01> <FE> <128 bytes> <CRCH> <CRCL>
000057r 1  D0 EF        		bne	GetBlk		; get 132 characters
000059r 1  A2 00        		ldx	#$00		;
00005Br 1  BD rr rr     		lda	Rbuff,x		; get block # from buffer
00005Er 1  C5 rr        		cmp	blkno		; compare to expected block #
000060r 1  F0 0F        		beq	GoodBlk1	; matched!
000062r 1               		;jsr	Print_Err	; Unexpected block number - abort
000062r 1  A9 rr 85 rr      loadptr error_message, console_out_ptr
000066r 1  A9 rr 85 rr  
00006Ar 1  20 rr rr         jsr console_write_string
00006Dr 1  20 rr rr     		jsr	Flush		; mismatched - flush buffer and then do BRK
000070r 1               ;		lda	#$FD		; put error code in "A" if desired
000070r 1  00           		brk			; unexpected block # - fatal error - BRK or RTS
000071r 1  49 FF        GoodBlk1:	eor	#$ff		; 1's comp of block #
000073r 1  E8           		inx			;
000074r 1  DD rr rr     		cmp	Rbuff,x		; compare with expected 1's comp of block #
000077r 1  F0 0F        		beq	GoodBlk2 	; matched!
000079r 1               		;jsr	Print_Err	; Unexpected block number - abort
000079r 1  A9 rr 85 rr      loadptr error_message, console_out_ptr
00007Dr 1  A9 rr 85 rr  
000081r 1  20 rr rr         jsr console_write_string
000084r 1  20 rr rr     		jsr 	Flush		; mismatched - flush buffer and then do BRK
000087r 1               ;		lda	#$FC		; put error code in "A" if desired
000087r 1  00           		brk			; bad 1's comp of block#
000088r 1  A0 02        GoodBlk2:	ldy	#$02		;
00008Ar 1  B9 rr rr     CalcCrc:		lda	Rbuff,y		; calculate the CRC for the 128 bytes of data
00008Dr 1  20 rr rr     		jsr	UpdCrc		; could inline sub here for speed
000090r 1  C8           		iny			;
000091r 1  C0 82        		cpy	#$82		; 128 bytes
000093r 1  D0 F5        		bne	CalcCrc		;
000095r 1  B9 rr rr     		lda	Rbuff,y		; get hi CRC from buffer
000098r 1  C5 rr        		cmp	crc+1		; compare to calculated hi CRC
00009Ar 1  D0 08        		bne	BadCrc		; bad crc, send NAK
00009Cr 1  C8           		iny			;
00009Dr 1  B9 rr rr     		lda	Rbuff,y		; get lo CRC from buffer
0000A0r 1  C5 rr        		cmp	crc		; compare to calculated lo CRC
0000A2r 1  F0 0B        		beq	GoodCrc		; good CRC
0000A4r 1  20 rr rr     BadCrc:		jsr	Flush		; flush the input port
0000A7r 1  A9 15        		lda	#NAK		;
0000A9r 1  20 rr rr     		jsr	console_write_byte		; send NAK to resend block
0000ACr 1  4C rr rr     		jmp	StartBlk	; start over, get the block again
0000AFr 1  A2 02        GoodCrc:		ldx	#$02		;
0000B1r 1  A5 rr        		lda	blkno		; get the block number
0000B3r 1  C9 01        		cmp	#$01		; 1st block?
0000B5r 1  D0 12        		bne	CopyBlk		; no, copy all 128 bytes
0000B7r 1  A5 rr        		lda	bflag		; is it really block 1, not block 257, 513 etc.
0000B9r 1  F0 0E        		beq	CopyBlk		; no, copy all 128 bytes
0000BBr 1  BD rr rr     		lda	Rbuff,x		; get target address from 1st 2 bytes of blk 1
0000BEr 1  85 rr        		sta	ptr		; save lo address
0000C0r 1  E8           		inx			;
0000C1r 1  BD rr rr     		lda	Rbuff,x		; get hi address
0000C4r 1  85 rr        		sta	ptr+1		; save it
0000C6r 1  E8           		inx			; point to first byte of data
0000C7r 1  C6 rr        		dec	bflag		; set the flag so we won't get another address
0000C9r 1  A0 00        CopyBlk:		ldy	#$00		; set offset to zero
0000CBr 1  BD rr rr     CopyBlk3:	lda	Rbuff,x		; get data byte from buffer
0000CEr 1  91 rr        		sta	(ptr),y		; save to target
0000D0r 1  E6 rr        		inc	ptr		; point to next address
0000D2r 1  D0 02        		bne	CopyBlk4	; did it step over page boundary?
0000D4r 1  E6 rr        		inc	ptr+1		; adjust high address for page crossing
0000D6r 1  E8           CopyBlk4:	inx			; point to next data byte
0000D7r 1  E0 82        		cpx	#$82		; is it the last byte
0000D9r 1  D0 F0        		bne	CopyBlk3	; no, get the next one
0000DBr 1  E6 rr        IncBlk:		inc	blkno		; done.  Inc the block #
0000DDr 1  A9 06        		lda	#ACK		; send ACK
0000DFr 1  20 rr rr     		jsr	console_write_byte		;
0000E2r 1  4C rr rr     		jmp	StartBlk	; get next block
0000E5r 1  A9 06        Done:		lda	#ACK		; last block, send ACK and exit.
0000E7r 1  20 rr rr     		jsr	console_write_byte		;
0000EAr 1  20 rr rr     		jsr	Flush		; get leftover characters, if any
0000EDr 1               		;jsr	Print_Good	;
0000EDr 1  A9 rr 85 rr      loadptr success_message, console_out_ptr
0000F1r 1  A9 rr 85 rr  
0000F5r 1  20 rr rr         jsr console_write_string
0000F8r 1  60           		rts			;
0000F9r 1               ;
0000F9r 1               ;^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
0000F9r 1               ;
0000F9r 1               ; subroutines
0000F9r 1               ;
0000F9r 1               ;					;
0000F9r 1  A9 00        GetByte:		lda	#$00		; wait for chr input and cycle timing loop
0000FBr 1  85 rr        		sta	retry		; set low value of timing loop
0000FDr 1  20 rr rr     StartCrcLp:	jsr	Get_Chr		; get chr from serial port, don't wait
000100r 1  B0 09        		bcs	GetByte1	; got one, so exit
000102r 1  C6 rr        		dec	retry		; no character received, so dec counter
000104r 1  D0 F7        		bne	StartCrcLp	;
000106r 1  C6 rr        		dec	retry2		; dec hi byte of counter
000108r 1  D0 F3        		bne	StartCrcLp	; look for character again
00010Ar 1  18           		clc			; if loop times out, CLC, else SEC and return
00010Br 1  60           GetByte1:	rts			; with character in "A"
00010Cr 1               ;
00010Cr 1  A9 70        Flush:		lda	#$70		; flush receive buffer
00010Er 1  85 rr        		sta	retry2		; flush until empty for ~1 sec.
000110r 1  20 rr rr     Flush1:		jsr	GetByte		; read the port
000113r 1  B0 F7        		bcs	Flush		; if chr recvd, wait for another
000115r 1  60           		rts			; else done
000116r 1               ;
000116r 1  45 rr        UpdCrc:		eor 	crc+1 		; Quick CRC computation with lookup tables
000118r 1  AA                  		tax		 	; updates the two bytes at crc & crc+1
000119r 1  A5 rr               		lda 	crc		; with the byte send in the "A" register
00011Br 1  5D rr rr            		eor 	crchi,X
00011Er 1  85 rr               		sta 	crc+1
000120r 1  BD rr rr           	 	lda 	crclo,X
000123r 1  85 rr               		sta 	crc
000125r 1  60                  		rts
000126r 1               
000126r 1  18           Get_Chr:		clc			; no chr present
000127r 1  AD rr rr                    	lda	ACIA1_STATUS     ; get Serial port status
00012Ar 1  29 08                       	and	#$08            ; mask rcvr full bit
00012Cr 1  F0 04                      	beq	Get_Chr2	; if not chr, done
00012Er 1  AD rr rr                    	Lda	ACIA1_DATA       ; else get chr
000131r 1  38           	       	sec			; and set the Carry Flag
000132r 1  60           Get_Chr2:    	rts			; done
000133r 1               
000133r 1               
