000000r 1               
000000r 1               .import spi_rw_byte, spi_r_byte, spi_select_device, spi_deselect
000000r 1               
000000r 1               .export sdcard_init, sdcard_detect
000000r 1               .export sd_select_card, sd_deselect_card
000000r 1               .export sd_read_block, sd_cmd, sd_cmd_lba
000000r 1               .export fullblock
