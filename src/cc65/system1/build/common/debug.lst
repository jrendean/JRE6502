000000r 2               .macro memcpy2ptr src, ptr, n
000000r 2               		.local @l
000000r 2               		;.assert n<$80, error, "n must not >=$80"
000000r 2               		ldy #n-1
000000r 2               @l:		lda src,y
000000r 2               		sta (ptr),y
000000r 2               		dey
000000r 2               		bpl @l
000000r 2               .endmacro
000000r 2               
000000r 2               .macro memset dest, value, n
000000r 2               		.local @l
000000r 2               		;.assert n<$80, error, "n must not >=$80"
000000r 2               		ldy #n-1
000000r 2               		lda #value
000000r 2               @l:		sta dest,y
000000r 2               		dey
000000r 2               		bpl @l
000000r 2               .endmacro
