000000r 2               .macro memcpy src, dest, n
000000r 2               		.local @l
000000r 2               		;.assert n<$80, error, "n must not >=$80"
000000r 2               		ldy #n-1
000000r 2               @l:
000000r 2               		lda src,y
000000r 2               		sta dest,y
000000r 2               		dey
000000r 2               		bpl @l
000000r 2               .endmacro
