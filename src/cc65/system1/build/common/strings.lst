000000r 1               
000000r 1               .export str_length, str_compare, str_trim
000000r 1               
000000r 1                 ;
000000r 1                 ; IN:
000000r 1                 ; OUT: A is the length of the string
000000r 1                 ; ZP: ptr1
000000r 1                 str_length:
000000r 1  5A               phy       ; save Y
000001r 1  A0 00            ldy #0    ; set Y to 0
000003r 1                 @loop:
000003r 1  B1 rr            lda (ptr1), y ; load value from ptr1 index Y in to A
000005r 1  F0 03            beq @done   ; if value equals 0 branch to @done
000007r 1  C8               iny       ; increment Y
000008r 1  80 F9            bra @loop   ; branch back
00000Ar 1                 @done:
00000Ar 1  98               tya       ; transfer Y to A
00000Br 1  7A               ply       ; restore Y
00000Cr 1  60               rts       ; return
00000Dr 1               
00000Dr 1               
00000Dr 1                 ; http://6502.org/source/strings/comparisons.html
00000Dr 1                 ;
00000Dr 1                 ;
00000Dr 1                 ;
00000Dr 1                 ;
00000Dr 1                 str_compare:
00000Dr 1  5A                 phy
00000Er 1  A0 00              ldy #$00
000010r 1                 @compare:
000010r 1  B1 rr              lda (ptr1),y
000012r 1  F0 09              beq @ptr1_end
000014r 1  D1 rr              cmp (ptr2),y
000016r 1  D0 07              bne @set_result
000018r 1  C8                 iny
000019r 1  F0 0C              beq @equal ; prevention against infinite loop
00001Br 1  80 F3              bra @compare
00001Dr 1                 @ptr1_end:
00001Dr 1  D1 rr              cmp (ptr2),y
00001Fr 1                 @set_result:
00001Fr 1  F0 06              beq @equal
000021r 1  30 08              bmi @less_than
000023r 1  A9 01              lda #$01
000025r 1  80 08              bra @return
000027r 1                 @equal:
000027r 1  A9 00              lda #$00
000029r 1  80 04              bra @return
00002Br 1                 @less_than:
00002Br 1  A9 FF              lda #$ff
00002Dr 1  80 00              bra @return
00002Fr 1                 @return:
00002Fr 1  7A                 ply
000030r 1  60                 rts
000031r 1               
000031r 1               
000031r 1               
000031r 1                 ;
000031r 1                 ;
000031r 1                 ;
000031r 1                 ;
000031r 1                 str_trim:
000031r 1  5A               phy
000032r 1  A0 00            ldy #0
000034r 1                 @loop:
