000000r 1               
000000r 1               .import delay_ms
000000r 1               
000000r 1               .export led_init, led_on, led_off, led_flash
000000r 1               
000000r 1               .code
000000r 1               
000000r 1                 ; Initializes the LED
000000r 1                 ; IN: Nothing
000000r 1                 ; OUT: Nothing
000000r 1                 ; ZP: Nothing
000000r 1                 led_init:
000000r 1  48               pha
000001r 1  20 rr rr         jsr led_off
000004r 1  68               pla
000005r 1  60               rts
000006r 1               
000006r 1                 ; Turns the LED on
000006r 1                 ; IN: Nothing
000006r 1                 ; OUT: Nothing
000006r 1                 ; ZP: Nothing
000006r 1                 led_on:
000006r 1  48               pha
000007r 1  AD rr rr         lda LED_PORT ; load existing values
00000Ar 1  05 01            ora PIN_LED  ; or the value to set led pin on
00000Cr 1  8D rr rr         sta LED_PORT
00000Fr 1  68               pla
000010r 1  60               rts
000011r 1               
000011r 1                 ; Turns the LED off
000011r 1                 ; IN: Nothing
000011r 1                 ; OUT: Nothing
000011r 1                 ; ZP: Nothing
000011r 1                 led_off:
000011r 1  48               pha
000012r 1  AD rr rr         lda LED_PORT ; load existing values
000015r 1  45 01            eor PIN_LED  ; eor the value to set the led pin off
000017r 1  8D rr rr         sta LED_PORT
00001Ar 1  68               pla
00001Br 1  60               rts
00001Cr 1               
00001Cr 1                 ; Turns the LED on and then off with a 150ms delay in between and before returning
00001Cr 1                 ; IN: Nothing
00001Cr 1                 ; OUT: Nothing
00001Cr 1                 ; ZP: Nothing
00001Cr 1                 led_flash:
00001Cr 1  20 rr rr         jsr led_on
00001Fr 1  A9 96            lda #150
000021r 1  20 rr rr         jsr delay_ms
000024r 1  20 rr rr         jsr led_off
000027r 1  20 rr rr         jsr delay_ms
00002Ar 1  60               rts
00002Ar 1               
