000000r 1               
000000r 1               ;
000000r 1               ; https://bitbucket.org/steckschwein/steckschwein-code/src/master/steckos/libsrc/spi/
000000r 1               ;
000000r 1               
000000r 1               .export spi_select_device, spi_deselect, spi_r_byte, spi_rw_byte
000000r 1               
000000r 1               EOK = 0
000000r 1               EBUSY = 6
000000r 1               
000000r 1               .code
000000r 1               
000000r 1               
000000r 1                 ; select spi device given in A. the method is aware of the current processor state, especially the interrupt flag
000000r 1                 ; in:
000000r 1                 ;    A = spi device - one of
000000r 1                 ;        spi_device_sdcard    =   %00011100 ;spi device number 1110??? (SPI_SS1)
000000r 1                 ;        spi_device_keyboard =   %00011010 ;spi device number 1101??? (SPI_SS2)
000000r 1                 ;        spi_device_rtc        =   %00010110 ;spi device number 1011??? (SPI_SS3)
000000r 1                 ; out:
000000r 1                 ;    Z = 1 spi for given device could be selected (not busy), Z=0 otherwise
000000r 1                 spi_select_device:
000000r 1  08                   php
000001r 1  78                   sei ;critical section start
000002r 1  48                   pha
000003r 1               
000003r 1                       ;check busy and select within sei => !ATTENTION! is busy check and spi device select must be "atomic", otherwise the spi state may change in between
000003r 1                       ;    Z=1 not busy, Z=0 spi is busy and A=#EBUSY
000003r 1                 spi_isbusy:
000003r 1  AD rr rr             lda SPI_PORT
000006r 1  29 1E                and #%00011110
000008r 1  C9 1E                cmp #%00011110
00000Ar 1  D0 08                bne @l_exit        ;busy, leave section, device could not be selected
00000Cr 1               
00000Cr 1  68                   pla
00000Dr 1  8D rr rr             sta SPI_PORT
000010r 1               
000010r 1  28                   plp
000011r 1  A9 00                lda #EOK            ;exit ok
000013r 1  60                   rts
000014r 1                 @l_exit:
000014r 1  68                   pla
000015r 1  28                   plp                ;restore P (interrupt flag)
000016r 1  A9 06                lda #EBUSY
000018r 1  60                   rts
000019r 1               
000019r 1               
000019r 1               
000019r 1                 spi_deselect:
000019r 1  48                   pha
00001Ar 1  A9 1E                lda #spi_device_deselect
00001Cr 1  8D rr rr             sta SPI_PORT
00001Fr 1  68                   pla
000020r 1  60                   rts
000021r 1               
000021r 1               
000021r 1               ;----------------------------------------------------------------------------------------------
000021r 1               ; Receive byte VIA SPI
000021r 1               ; Received byte in A at exit, Z, N flags set accordingly to A
000021r 1               ; Destructive: A,X
000021r 1               ;----------------------------------------------------------------------------------------------
000021r 1               spi_r_byte:
000021r 1  AD rr rr             lda SPI_PORT    ; Port laden
000024r 1  29 FE                AND #$fe          ; Takt ausschalten
000026r 1  AA                   TAX                         ; aufheben
000027r 1  1A                   INC
000028r 1               
000028r 1  8D rr rr             STA SPI_PORT ; Takt An 1
00002Br 1  8E rr rr             STX SPI_PORT ; Takt aus
00002Er 1  8D rr rr             STA SPI_PORT ; Takt An 2
000031r 1  8E rr rr             STX SPI_PORT ; Takt aus
000034r 1  8D rr rr             STA SPI_PORT ; Takt An 3
000037r 1  8E rr rr             STX SPI_PORT ; Takt aus
00003Ar 1  8D rr rr             STA SPI_PORT ; Takt An 4
00003Dr 1  8E rr rr             STX SPI_PORT ; Takt aus
000040r 1  8D rr rr             STA SPI_PORT ; Takt An 5
000043r 1  8E rr rr             STX SPI_PORT ; Takt aus
000046r 1  8D rr rr             STA SPI_PORT ; Takt An 6
000049r 1  8E rr rr             STX SPI_PORT ; Takt aus
00004Cr 1  8D rr rr             STA SPI_PORT ; Takt An 7
00004Fr 1  8E rr rr             STX SPI_PORT ; Takt aus
000052r 1  8D rr rr             STA SPI_PORT ; Takt An 8
000055r 1  8E rr rr             STX SPI_PORT ; Takt aus
000058r 1               
000058r 1  AD rr rr             lda SPI_SR
00005Br 1  60                   rts
00005Cr 1               
00005Cr 1               
00005Cr 1               ;----------------------------------------------------------------------------------------------
00005Cr 1               ; Transmit byte VIA SPI
00005Cr 1               ; Byte to transmit in A, received byte in A at exit
00005Cr 1               ; Destructive: A,X,Y
00005Cr 1               ;----------------------------------------------------------------------------------------------
00005Cr 1               spi_rw_byte:
00005Cr 1  85 rr                sta spi_sr    ; zu transferierendes byte im akku retten
00005Er 1               
00005Er 1  A2 08                ldx #$08
000060r 1               
000060r 1  AD rr rr             lda SPI_PORT    ; Port laden
000063r 1  29 FE                and #$fe          ; SPICLK loeschen
000065r 1               
000065r 1  0A                   asl                ; Nach links rotieren, damit das bit nachher an der richtigen stelle steht
000066r 1  A8                   tay                 ; bunkern
000067r 1               
000067r 1               @l:
000067r 1  26 rr                rol spi_sr
000069r 1  98                   tya                ; portinhalt
00006Ar 1  6A                   ror                ; datenbit reinschieben
00006Br 1               
00006Br 1  8D rr rr             sta SPI_PORT    ; ab in den port
00006Er 1  EE rr rr             inc SPI_PORT    ; takt an
000071r 1  8D rr rr             sta SPI_PORT    ; takt aus
000074r 1               
000074r 1  CA                   dex
000075r 1  D0 F0                bne @l            ; schon acht mal?
000077r 1               
000077r 1  AD rr rr             lda SPI_SR        ; Schieberegister auslesen
00007Ar 1               
00007Ar 1  60                   rts
00007Ar 1               
