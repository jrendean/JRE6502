000000r 1               
000000r 1               ; define vector
000000r 1               .segment "VECTORS" ;defined in firmware.cfg starting at $FFFA
000000r 1               
000000r 1  rr rr            .word   nmi     ; $FFFA-$FFFB - MNI
000002r 1  rr rr            .word   reset   ; $FFFC-$FFFD - Reset
000004r 1  rr rr            .word   irq     ; $FFFE-$FFFF - IRQ/BRK
000006r 1               
000006r 1               .code
000000r 1               
000000r 1               
000000r 1                 nmi:
000000r 1  40                 rti
000001r 1               
000001r 1               
000001r 1                 ; http://wilsonminesco.com/6502interrupts/index.html
000001r 1                 irq:
000001r 1  48                 pha
000002r 1  DA                 phx
000003r 1  5A                 phy
000004r 1               
000004r 1  2C rr rr           bit  VIA1_IFR   ; Check 6522 VIA1's status register without loading.
000007r 1  30 08              bmi  @service_via1  ; If it caused the interrupt, branch to service it.
000009r 1  2C rr rr           bit  VIA2_IFR   ; Otherwise, check VIA2's status register.
00000Cr 1  30 09              bmi  @service_via2
00000Er 1  4C rr rr           jmp @irq_done
000011r 1               
000011r 1                   @service_via1:
000011r 1  2C rr rr           BIT   VIA1_T1CL
000014r 1  20 rr rr           jsr joystick_scan
000017r 1                   @service_via2:
000017r 1  2C rr rr           BIT   VIA2_T1CL
00001Ar 1                     ;jsr led_flash
00001Ar 1                     ;jsr joystick_scan
00001Ar 1               
00001Ar 1                   @irq_done:
00001Ar 1  7A                 ply
00001Br 1  FA                 plx
00001Cr 1  68                 pla
00001Dr 1               
00001Dr 1  40                 rti
00001Er 1               
00001Er 1               
00001Er 1               
00001Er 1                 reset:
00001Er 1  D8                 cld         ; clear decimal (use hex)
00001Fr 1               
00001Fr 1  78                 sei         ; set interupt disable (do not take interupts)
000020r 1               
000020r 1  A2 00              ldx #$00    ; clear the zero page and stack
000022r 1  74 00            : stz $0000,x ;zero page
000024r 1  9E 00 01           stz $0100,x ;user buffers and vars
000027r 1  E8                 inx
000028r 1  D0 F8              bne :-
00002Ar 1               
00002Ar 1  A2 FF              ldx #$ff    ; load FF in to X register
00002Cr 1  9A                 txs         ; set the stack pointer to the top (00FF)
00002Dr 1               
00002Dr 1  20 rr rr           jsr initialize
000030r 1               
000030r 1  58                 cli         ; clear interupt disable (start taking interupts)
000031r 1               
000031r 1               
000031r 1               
000031r 1               
000031r 1               
000031r 1                 loop:
000031r 1               
000031r 1                     ; print welcome message
000031r 1  A9 rr 85 rr        loadptr terminal_message, console_out_ptr
000035r 1  A9 rr 85 rr  
000039r 1  20 rr rr           jsr console_write_string
00003Cr 1               
00003Cr 1               
00003Cr 1               
00003Cr 1  A9 rr 85 rr        loadptr console_buffer, ptr1
000040r 1  A9 rr 85 rr  
000044r 1  A9 14              lda #BUFFLEN
000046r 1  20 rr rr           jsr console_read_string
000049r 1               
000049r 1               
000049r 1  AD rr rr           lda console_buffer
00004Cr 1  D0 03              bne @actual_command
00004Er 1  4C rr rr           jmp loop
000051r 1               
000051r 1                   @actual_command:
000051r 1               
000051r 1  A9 rr 85 rr        loadptr cmd_on, ptr2
000055r 1  A9 rr 85 rr  
000059r 1  20 rr rr           jsr str_compare
00005Cr 1  C9 00              cmp #$00
00005Er 1  F0 58              beq @on
000060r 1               
000060r 1  A9 rr 85 rr        loadptr cmd_off, ptr2
000064r 1  A9 rr 85 rr  
000068r 1  20 rr rr           jsr str_compare
00006Br 1  C9 00              cmp #$00
00006Dr 1  F0 4F              beq @off
00006Fr 1               
00006Fr 1  A9 rr 85 rr        loadptr cmd_xmodem, ptr2
000073r 1  A9 rr 85 rr  
000077r 1  20 rr rr           jsr str_compare
00007Ar 1  C9 00              cmp #$00
00007Cr 1  F0 46              beq @xmodem
00007Er 1               
00007Er 1  A9 rr 85 rr        loadptr cmd_kbtest, ptr2
000082r 1  A9 rr 85 rr  
000086r 1  20 rr rr           jsr str_compare
000089r 1  C9 00              cmp #$00
00008Br 1  F0 40              beq @kbtest
00008Dr 1               
00008Dr 1  A9 rr 85 rr        loadptr cmd_debugger, ptr2
000091r 1  A9 rr 85 rr  
000095r 1  20 rr rr           jsr str_compare
000098r 1  C9 00              cmp #$00
00009Ar 1  F0 37              beq @debugger
00009Cr 1               
00009Cr 1               
00009Cr 1  AD rr rr           lda console_buffer
00009Fr 1  C9 73              cmp #'s'
0000A1r 1  F0 36              beq @snes
0000A3r 1               
0000A3r 1  C9 74              cmp #'t'
0000A5r 1  F0 38              beq @time
0000A7r 1               
0000A7r 1                     ;cmp #'y'
0000A7r 1                     ;jsr rtc_settime
0000A7r 1               
0000A7r 1                     ;cmp #'h'
0000A7r 1                     ;beq @ra8875
0000A7r 1               
0000A7r 1                   @unknown:
0000A7r 1  A9 rr 85 rr        loadptr unknown_command, console_out_ptr
0000ABr 1  A9 rr 85 rr  
0000AFr 1  20 rr rr           jsr console_write_string
0000B2r 1  20 rr rr           jsr console_write_newline
0000B5r 1  4C rr rr           jmp loop
0000B8r 1               
0000B8r 1                   @on:
0000B8r 1  20 rr rr           jsr led_on
0000BBr 1  4C rr rr           jmp loop
0000BEr 1               
0000BEr 1                   @off:
0000BEr 1  20 rr rr           jsr led_off
0000C1r 1  4C rr rr           jmp loop
0000C4r 1               
0000C4r 1                   @xmodem:
0000C4r 1  20 rr rr           jsr modem_receive
0000C7r 1  20 00 10           jsr $1000
0000CAr 1  4C rr rr           jmp loop
0000CDr 1               
0000CDr 1                   @kbtest:
0000CDr 1  4C rr rr           jmp kbtest
0000D0r 1  4C rr rr           jmp loop
0000D3r 1               
0000D3r 1                   @debugger:
0000D3r 1  20 rr rr           jsr debugger_run
0000D6r 1  4C rr rr           jmp loop
0000D9r 1               
