000000r 2               
000000r 2               ;
000000r 2               .macro loadptr src, dest
000000r 2                 lda #<(src)
000000r 2                 sta dest
000000r 2                 lda #>(src)
000000r 2                 sta dest + 1
000000r 2               .endmacro
000000r 2               
000000r 2               .macro copyptr111 src, dest
000000r 2                 lda src
000000r 2                 sta dest
000000r 2                 lda src + 1
000000r 2                 sta dest + 1
000000r 2               .endmacro
000000r 2               
000000r 2               
000000r 2               
000000r 2               
000000r 2               
000000r 2               
000000r 2               
000000r 2               
000000r 2               .macro copypointer fromptr, toptr
000000r 2               	.repeat 2, i
000000r 2               		lda fromptr+i
000000r 2               		sta toptr	+i
000000r 2               	.endrepeat
000000r 2               .endmacro
000000r 2               
000000r 2               .macro saveptr ptr
000000r 2               	lda ptr
000000r 2               	pha
000000r 2               	lda ptr+1
000000r 2               	pha
000000r 2               .endmacro
000000r 2               
000000r 2               .macro restoreptr ptr
000000r 2               	pla
000000r 2               	sta ptr+1
000000r 2               	pla
000000r 2               	sta ptr
000000r 2               .endmacro
000000r 2               
000000r 2               
000000r 2               .macro memcpy src, dest, n
000000r 2               		.local @l
000000r 2               		;.assert n<$80, error, "n must not >=$80"
000000r 2               		ldy #n-1
000000r 2               @l:
000000r 2               		lda src,y
000000r 2               		sta dest,y
000000r 2               		dey
000000r 2               		bpl @l
000000r 2               .endmacro
000000r 2               
000000r 2               .macro memcpy2ptr src, ptr, n
000000r 2               		.local @l
000000r 2               		;.assert n<$80, error, "n must not >=$80"
000000r 2               		ldy #n-1
000000r 2               @l:		lda src,y
000000r 2               		sta (ptr),y
000000r 2               		dey
000000r 2               		bpl @l
000000r 2               .endmacro
000000r 2               
000000r 2               .macro memset dest, value, n
000000r 2               		.local @l
000000r 2               		;.assert n<$80, error, "n must not >=$80"
000000r 2               		ldy #n-1
000000r 2               		lda #value
000000r 2               @l:		sta dest,y
000000r 2               		dey
000000r 2               		bpl @l
000000r 2               .endmacro
000000r 2               
000000r 2               .macro memclr dest, n
000000r 2               		;.assert n<$80, error, "n must not >=$80"
000000r 2               		.local @l
000000r 2               		ldx #n-1
000000r 2               @l:		stz dest,x
000000r 2               		dex
000000r 2               		bpl @l
000000r 2               .endmacro
