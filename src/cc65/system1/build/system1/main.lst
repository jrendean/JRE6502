000233r 1               
000233r 1               
000233r 1                   ; setup timers on VIA1 for interupt processing
000233r 1                   ; http://wilsonminesco.com/6502interrupts/index.html
000233r 1  A9 FF            lda #$FF        ; put FFFF (65535) in VIA timer 1 counter
000235r 1  8D rr rr         sta VIA1_T1CL   ; this will make the timeout 61 times per
000238r 1  8D rr rr         sta VIA1_T1CH   ; second with the 4mhz clock
00023Br 1               
00023Br 1  AD rr rr         lda VIA1_ACR    ; Clear the ACR's bit that
00023Er 1  29 7F            and #%01111111  ; tells T1 to toggle PB7 upon time-out, and
000240r 1  09 40            ora #%01000000  ; set the bit that tells T1 to automatically
000242r 1  8D rr rr         sta VIA1_ACR    ; produce an interrupt at every time-out and
000245r 1                                   ; just reload from the latches and keep going.
000245r 1  A9 C0            lda #%11000000
000247r 1  8D rr rr         sta VIA1_IER    ; Enable the T1 interrupt in the VIA.
00024Ar 1               
00024Ar 1                   ; initialization complete
00024Ar 1  20 rr rr         jsr primm_console
00024Dr 1  49 6E 69 74      .asciiz "Initialization complete"
000251r 1  69 61 6C 69  
000255r 1  7A 61 74 69  
