00012Br 1                     kbtest:
00012Br 1  20 rr rr             jsr KBINIT            ; init the keyboard, LEDs, and flags
00012Er 1                     lp0:
00012Er 1  20 rr rr             jsr console_write_newline          ; prints 0D 0A (CR LF) to the terminal
000131r 1                     lp1:
000131r 1  20 rr rr             jsr KBINPUT           ; wait for a keypress, return decoded ASCII code in A
000134r 1  C9 0D                cmp #$0d              ; if CR, then print CR LF to terminal
000136r 1  F0 F6                beq lp0               ;
000138r 1  C9 1B                cmp #$1B              ; esc ascii code
00013Ar 1  F0 0D                beq lp2               ;
00013Cr 1  C9 20                cmp #$20              ;
00013Er 1  90 0C                bcc lp3               ; control key, print as <hh> except $0d (CR) & $2B (Esc)
000140r 1  C9 80                cmp #$80              ;
000142r 1  B0 08                bcs lp3               ; extended key, just print the hex ascii code as <hh>
000144r 1  20 rr rr             jsr console_write_byte            ; prints contents of A reg to the Terminal, ascii 20-7F
000147r 1  80 E8                bra lp1               ;
000149r 1                     lp2:
000149r 1  4C rr rr             jmp loop
00014Cr 1                       ;rts                     ; done
00014Cr 1                     lp3:
00014Cr 1  48                   pha                     ;
00014Dr 1  A9 3C                lda #$3C              ; <
00014Fr 1  20 rr rr             jsr console_write_byte            ;
000152r 1  68                   pla                   ;
000153r 1  20 rr rr             jsr console_write_hex        ; print 1 byte in ascii hex
000156r 1  A9 3E                lda #$3E              ; >
000158r 1  20 rr rr             jsr console_write_byte            ;
00015Br 1  80 D4                bra lp1               ;
